  {k:/付款|付錢|pay|cash|現金/i,z:"到店取餐時付款；宅配付款方式由 LINE 客服與您確認。",e:"Pay at pick-up. For delivery, we'll confirm payment on LINE."},
  {k:/素|vegetarian|vegan/i,z:"米粉以豬油炒香，肉燥含豬肉，暫無全素選項。",e:"Our vermicelli is fried in lard and topped with pork sauce, so there's no vegetarian option."}
];

const $ = s => document.querySelector(s), money = n => "NT$" + n.toLocaleString();
let lang = "zh", cart = [], mode = "pick";

try {
  const r = JSON.parse(localStorage.getItem("cl-cart") || "[]");
  if(Array.isArray(r)) cart = r.filter(x => P.some(p => p.id === x.id));
} catch(e) {}
try {
  if(localStorage.getItem("cl-lang") === "en") lang = "en";
} catch(e) {}

const save = () => {
  try {
    localStorage.setItem("cl-cart", JSON.stringify(cart));
    localStorage.setItem("cl-lang", lang);
  } catch(e) {}
};

const L = (z, e) => lang === "zh" ? z : e, nm = p => L(p.z, p.e), canShip = p => p.g === "c" || p.s;
const lineUrl = "https://line.me/R/ti/p/" + encodeURIComponent(LINE_ID);
["#lineNav", "#lineFoot"].forEach(s => $(s).href = lineUrl);

function card(p){
  const t = p.g === "c" ? L("可宅配","Delivery") : p.s ? L("自取／宅配皆可","Pick-up / Delivery") : L("限門市自取","Pick-up only");
  return `<article class="item">
    <span class="tag ${p.g === "d" && !p.s ? "x" : ""}">${t}</span>
    <h3>${nm(p)}</h3>
    <p>${L(p.dz, p.de)}</p>
    <div class="row">
      ${p.o.map((o,i)=>`<button class="add" data-id="${p.id}" data-i="${i}">${L(o[0],o[1])} <small>${money(o[2])}</small> ＋${L("加入","Add")}</button>`).join("")}
    </div>
  </article>`;
}

const RV = [
  {s:"大心日常分享（Dcard）",u:"https://www.dcard.tw/@agoodlife1986/post/242440306",z:"假日內用外帶都要排隊，多半是在地老顧客。米粉炒麵淋上肉燥吃起來有層次、不油膩；豬血湯新鮮滑順，沒有腥味。",e:"Queues on weekends, mostly locals. The vermicelli and noodles with pork sauce taste layered but not greasy, and the pig blood soup is fresh, smooth and free of any odor."},
  {s:"大嘴巴菜單王（痞客邦・2021）",u:"https://boda88.pixnet.net/blog/posts/13361715577",z:"整修後環境耳目一新。炒米粉不乾，配肉燥很夠味；豬血湯料實在，大腸湯清甜，物超所值。",e:"The renovated shop feels fresh. The vermicelli isn't dry and the pork sauce is plenty flavorful; the pig blood soup is generous and the intestine soup is clear and sweet."},
  {s:"去旅行新聞網（2023）",u:"https://tournews.tw/archives/64485",z:"報導這家 1974 年開業的老店味道多年不變，是花蓮人愛的人氣小吃。出餐很快，排隊人龍一下就消化完。",e:"Reports on this shop, open since 1974, whose taste has stayed the same for decades. Service is quick, so long lines clear fast."},
  {s:"好好玩 FUNIT（2026 花蓮美食推薦）",u:"https://gofunit.com/%E8%8A%B1%E8%93%AE%E7%BE%8E%E9%A3%9F/",z:"列為在地人推薦的吉安美食。豬油拌炒的米粉不會太乾，辣菜脯與三色蛋也值得一試。",e:"Listed as a local-approved Ji'an favorite. Lard-fried vermicelli stays moist, and the spicy pickled radish and three-color egg are worth trying."},
  {s:"PopDaily 波波黛莉",u:"https://www.popdaily.com.tw/forum/food/1106888",z:"炒米粉與豬血湯必點，小菜也好吃。建議 9 點半左右人較少，吃完還能順道去慈惠堂拜拜。",e:"Fried vermicelli and pig blood soup are musts, and the side dishes are tasty. Fewer people around 9:30, and you can visit the temple afterward."},
  {s:"冰心問路（痞客邦）",u:"https://iceheart888.pixnet.net/blog/posts/16037027168",z:"老店重新裝潢後明亮可愛，價格依舊親民；炒米粉加一點自製辣椒更加分。",e:"The old shop is bright and cute after its makeover, prices are still friendly, and a little homemade chili makes the vermicelli even better."}
];

function rv(){
  $("#gridRv").innerHTML = RV.map(r=>`<article class="item rv">
    <h3><small>${L("食記・網友推薦","Blog / post")}</small>${r.s}</h3>
    <p>${L(r.z,r.e)}</p>
    <a href="${r.u}" target="_blank" rel="noopener noreferrer">${L("看完整食記 ↗","Read full post ↗")}</a>
  </article>`).join("");
}

function menu(){
  $("#gridDine").innerHTML = P.filter(p=>p.g==="d").map(card).join("");
  $("#gridCold").innerHTML = P.filter(p=>p.g==="c").map(card).join("");
}

document.addEventListener("click", e => {
  const b = e.target.closest(".add");
  if(!b) return;
  const p = P.find(x => x.id === b.dataset.id), o = p.o[+b.dataset.i], k = p.id + "|" + o[0], f = cart.find(x => x.k === k);
  f ? f.q++ : cart.push({k, id: p.id, i: +b.dataset.i, pr: o[2], q: 1});
  save(); render();
  $("#fab").classList.remove("pop");
  void $("#fab").offsetWidth;
  $("#fab").classList.add("pop");
});

function calc(){
  const sub = cart.reduce((s,x)=>s+x.pr*x.q,0), bad = mode === "ship" ? cart.filter(x => !canShip(P.find(p=>p.id===x.id))) : [];
  const fee = mode === "ship" && sub > 0 && sub < FREE_AT ? SHIP_FEE : 0;
  return {sub, bad, fee, total: sub + fee};
}

function render(){
  const {sub, bad, fee, total} = calc();
  $("#fabN").textContent = cart.reduce((s,x)=>s+x.q,0);
  $("#lines").innerHTML = cart.length ? cart.map((x,i)=>{
    const p = P.find(p=>p.id===x.id), o = p.o[x.i];
    return `<div class="ln">
      <div class="n">${nm(p)}</div>
      <div class="qty">
        <button data-d="-1" data-i="${i}" aria-label="-">−</button>
        <span>${x.q}</span>
        <button data-d="1" data-i="${i}" aria-label="+">＋</button>
      </div>
      <div class="m">${L(o[0],o[1])}・${money(x.pr)} → ${money(x.pr*x.q)}${mode==="ship"&&!canShip(p)?`<div class="warn">${L("此品項限門市自取，請移除或改選自取","Pick-up only. Remove it or switch to pick-up.")}</div>`:""}</div>
    </div>`;
  }).join("") : `<p class="note">${L("購物車是空的，先挑幾樣吧 🍜","Your cart is empty. Pick something tasty 🍜")}</p>`;

  const fb = $("#freeBox");
  fb.hidden = !(mode === "ship" && cart.length);
  if(!fb.hidden){
    const left = FREE_AT - sub;
    fb.innerHTML = (left > 0 ? L(`再買 <b>${money(left)}</b> 即可免低溫運費`,`Add <b>${money(left)}</b> more for free cold-chain shipping`) : L("<b>已達免運門檻 🎉</b>","<b>Free shipping unlocked 🎉</b>")) +
      `<div class="bar"><i style="width:${Math.min(100,sub/FREE_AT*100)}%"></i></div><span class="note">${money(sub)} / ${money(FREE_AT)}</span>`;
  }

  $("#sum").innerHTML = cart.length ? `<div><span>${L("商品小計","Subtotal")}</span><span>${money(sub)}</span></div>${mode==="ship"?`<div><span>${L("低溫運費","Shipping")}</span><span>${fee?money(fee):L("免運","Free")}</span></div>`:""}<div class="t"><span>${L("合計","Total")}</span><span>${money(total)}</span></div>` : "";
  $("#pickF").hidden = mode !== "pick";
  $("#shipF").hidden = mode !== "ship";
  $("#mPick").classList.toggle("on", mode === "pick");
  $("#mShip").classList.toggle("on", mode === "ship");
  $("#submit").disabled = !cart.length || bad.length > 0;
}

function i18n(){
  document.documentElement.lang = lang === "zh" ? "zh-Hant" : "en";
  document.querySelectorAll("[data-z]").forEach(el => el.textContent = lang === "zh" ? el.dataset.z : el.dataset.e);
  document.querySelectorAll("[data-pz]").forEach(el => el.placeholder = lang === "zh" ? el.dataset.pz : el.dataset.pe);
  $("#lang").textContent = lang === "zh" ? "EN" : "中文";
  menu(); rv(); render(); chips();
}

$("#lang").onclick = () => { lang = lang === "zh" ? "en" : "zh"; save(); i18n(); };
$("#lines").addEventListener("click", e => {
  const b = e.target.closest("button[data-d]");
  if(!b) return;
  const x = cart[+b.dataset.i];
  x.q += +b.dataset.d;
  if(x.q <= 0) cart.splice(+b.dataset.i, 1);
  save(); render();
});

$("#mPick").onclick = () => { mode = "pick"; render(); };
$("#mShip").onclick = () => { mode = "ship"; render(); };

const open = () => { $("#drawer").classList.add("on"); $("#veil").classList.add("on"); $("#drawer").setAttribute("aria-hidden","false"); };
const shut = () => { $("#drawer").classList.remove("on"); $("#veil").classList.remove("on"); $("#drawer").setAttribute("aria-hidden","true"); };
$("#fab").onclick = open; $("#close").onclick = shut; $("#veil").onclick = shut;
document.addEventListener("keydown", e => { if(e.key === "Escape"){ shut(); $("#modal").classList.remove("on"); $("#bot").classList.remove("on"); } });

document.querySelectorAll("[data-go]").forEach(b => b.onclick = () => {
  const g = b.dataset.go;
  if(g === "bot") return botOpen();
  mode = g; render(); $(g === "pick" ? "#order" : "#ship").scrollIntoView();
});

const says = [["今天也要吃飽飽！","Eat well today!"],["肉燥最香啦～","The pork sauce is the best!"],["蒸籠熱呼呼","Hot from the steamer!"],["週一要休息喔","We rest on Mondays!"]];
let si = 0;
$("#mas").onclick = () => {
  const s = says[si++ % says.length], m = $("#mas"), b = $("#bub");
  b.textContent = L(s[0], s[1]); b.classList.add("on");
  m.classList.remove("pop"); void m.offsetWidth; m.classList.add("pop");
  setTimeout(() => b.classList.remove("on"), 2200);
};

// 客服小福
const add = (c,t) => { const d = document.createElement("div"); d.className = c; d.textContent = t; $("#msgs").append(d); $("#msgs").scrollTop = 1e9; };
function chips(){
  const q = [["營業時間","Hours"],["地址","Address"],["怎麼點餐","How to order"],["宅配運費","Shipping fee"],["保存加熱","Storage"],["付款方式","Payment"]];
  $("#chips").innerHTML = q.map(a => `<button>${L(a[0],a[1])}</button>`).join("");
}
$("#chips").onclick = e => { if(e.target.tagName === "BUTTON") ask(e.target.textContent); };
function ask(t){
  t = t.trim(); if(!t) return; add("m2", t);
  const f = FAQ.find(x => x.k.test(t));
  setTimeout(() => add("m1", f ? L(f.z, f.e) : L("這個問題我還不確定 🥲 請點下方 LINE 找真人客服，或來電 03-852-3446（06:30–14:00）。","I'm not sure about that 🥲 Please message us on LINE or call 03-852-3446 (06:30–14:00).") + "\n" + lineUrl), 350);
}
function botOpen(){
  $("#bot").classList.add("on");
  if(!$("#msgs").children.length) add("m1", L("嗨，我是客服小福 🐷 24 小時自動回覆，常見問題都可以問我！訂單確認請以 LINE 真人回覆為準。","Hi, I'm Fu-Fu 🐷 I auto-reply 24/7 to common questions. Order confirmation comes from a real person on LINE."));
}
$("#fabB").onclick = () => $("#bot").classList.contains("on") ? $("#bot").classList.remove("on") : botOpen();
$("#botX").onclick = () => $("#bot").classList.remove("on");
$("#botGo").onclick = () => { ask($("#botIn").value); $("#botIn").value = ""; };
$("#botIn").onkeydown = e => { if(e.key === "Enter" && !e.isComposing) $("#botGo").click(); };

// ==================== 送單邏輯（強化語音朗讀與時間限制） ====================
let text = "";
$("#submit").onclick = () => {
  const v = id => $(id).value.trim(), {sub, fee, total} = calc(), err =$("#err"), name = v("#fName"), tel = v("#fTel");
  if(!name) return err.textContent = L("請填寫姓名","Please enter your name");
  if(!/^[0-9+\-\s()]{8,}$/.test(tel)) return err.textContent = L("請填寫正確電話","Please enter a valid phone number");
  
  const now = new Date();
  const pad = n => String(n).padStart(2, "0");

  if(mode === "pick"){
    const t = v("#fTime");
    if(!t) return err.textContent = L("請選擇取餐時間","Please choose a pick-up time");
    if(t < "06:30" || t > "14:00") return err.textContent = L("取餐時間需在營業時間內（06:30–14:00）","Pick-up must be 06:30–14:00");
    
    // 計算防呆：預約時間至少需要距離當前時間 20 分鐘以上
    const curMinutes = now.getHours() * 60 + now.getMinutes();
    const [th, tm] = t.split(":").map(Number);
    const pickMinutes = th * 60 + tm;
    if(now.getHours() >= 6 && now.getHours() < 14 && (pickMinutes - curMinutes < 20)){
      return err.textContent = L("現場備料需時間，取餐時間至少需在 20 分鐘後！急單請直接來電 03-852-3446","Please order at least 20 mins ahead! For urgent orders, call 03-852-3446 directly.");
    }
  } else if(!v("#fAddr")){
    return err.textContent = L("請填寫收件地址","Please enter a delivery address");
  }
  
  err.textContent = "";
  const no = "#" + pad(now.getMonth()+1) + pad(now.getDate()) + "-" + pad(now.getHours()) + pad(now.getMinutes());
  
  // 第一行帶有「春龍福新訂單」以及取餐規格，利於手機語音過濾與朗讀
  const head = mode === "pick" 
    ? `【春龍福新訂單】🥡【自取 ${v("#fTime")}】${no}｜${name}｜${money(total)}`
    : `【春龍福新訂單】🚚【黑貓低溫宅配】${no}｜${name}｜${money(total)}`;
  
  const Ls = [head, "────────────", "【訂購餐點品項】"];
  cart.forEach(x => {
    const p = P.find(p => p.id === x.id);
    Ls.push(`• ${p.z}（${p.o[x.i][0]}）× ${x.q} 碗/份 ＝ ${money(x.pr * x.q)}`);
  });
  Ls.push("────────────", `商品小計：${money(sub)}`);
  if(mode === "ship") Ls.push(`低溫運費：${fee ? money(fee) : "免運"}`);
  Ls.push(`應付總額：${money(total)}`, "", `訂購姓名：${name}`, `聯絡電話：${tel}`);
  if(mode === "ship"){
    Ls.push(`收件地址：${v("#fAddr")}`);
    if(v("#fDate")) Ls.push(`希望到貨日：${v("#fDate")}`);
  }
  if(v("#fLine")) Ls.push(`LINE ID：${v("#fLine")}`);
  if(v("#fNote")) Ls.push(`訂單備註：${v("#fNote")}`);
  
  text = Ls.join("\n");
  $("#orderTxt").textContent = text;
  
  // 兼顧手機 App 與桌機的最佳 LINE 跳轉協定
  $("#lineGo").href = `https://line.me/R/oaMessage/${LINE_ID}/?${encodeURIComponent(text)}`;
  $("#modal").classList.add("on");
};

// 點擊「一鍵傳送」時同步將文字複製到剪貼簿（防止部分裝置未自動帶入）
$("#lineGo").addEventListener("click", () => {
  try { navigator.clipboard.writeText(text).catch(()=>{}); } catch(e){}
});

$("#mClose").onclick = () => $("#modal").classList.remove("on");

$("#copy").onclick = async () => {
  try {
    await navigator.clipboard.writeText(text);
    $("#copy").textContent = L("已複製！可直接到 LINE 貼上","Copied!");
    setTimeout(() => $("#copy").textContent = L("複製訂單","Copy"), 2000);
  } catch(e) {
    const r = document.createRange();
    r.selectNodeContents($("#orderTxt"));
    const s = getSelection();
    s.removeAllRanges();
    s.addRange(r);
    $("#copy").textContent = L("請長按複製","Press & copy");
  }
};

i18n();
</script>
